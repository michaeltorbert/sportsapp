{
  "name": "saturday-signal-alerts",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "SITE_ORIGIN": "https://saturday-signal.mtorbert.chatgpt.site",
    "VAPID_SUBJECT": "https://saturday-signal.mtorbert.chatgpt.site"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "saturday-signal-alerts",
    "database_id": "REPLACE_WITH_CREATED_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true }
}
