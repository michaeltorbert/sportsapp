{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saturday-signal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "saturday-signal-preview",
      "workers_dev": true,
      "preview_urls": false,
      "kv_namespaces": [
        {
          "binding": "SEASON_LEADERS_KV",
          "id": "3844e1c06f7540ebb1707c697fd76d65"
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  },
  "kv_namespaces": [
    {
      "binding": "SEASON_LEADERS_KV",
      "id": "0092777d9645406a852177c251fcdffd"
    }
  ],
  "triggers": {
    "crons": [
      "0 5,17 * * *"
    ]
  }
}
