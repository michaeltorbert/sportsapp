{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saturday-signal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "name": "saturday-signal-preview",
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
